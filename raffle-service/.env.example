# hnm-raffle service config (copy to .env on the server; never commit real secrets)
PORT=3210
HNM_PUBLIC_BASE=https://hernextmission.org
HNM_EVENT_NAME=Her Next Mission 360 Raffle
HNM_TERMS_VERSION=2026-07-30

# Shared secret the GHL outbound webhook must send as header  x-hnm-secret
HNM_INTAKE_SECRET=change-me-long-random

# Shared secret for POST /api/raffle/video (Zap/Make/operator)
HNM_VIDEO_SECRET=change-me-long-random

# Admin/operator console (HTTP basic auth)
HNM_ADMIN_USER=hnm
HNM_ADMIN_PASS=set-a-strong-password

# Salt for hashing IPs (abuse prevention; no raw IPs stored)
HNM_IP_SALT=change-me

# Where the JSON store lives (defaults to ./data)
# HNM_DATA_DIR=/var/www/hnm-raffle/data

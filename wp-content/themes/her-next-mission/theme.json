{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "name": "Paper",     "slug": "paper",     "color": "#FFFFFF" },
                { "name": "Mist",      "slug": "mist",      "color": "#F5F4F0" },
                { "name": "Line",      "slug": "line",      "color": "#E6E3DC" },
                { "name": "Navy",      "slug": "navy",      "color": "#1F2A52" },
                { "name": "Navy Deep", "slug": "navy-deep", "color": "#0E1530" },
                { "name": "Purple",    "slug": "purple",    "color": "#3D2C6B" },
                { "name": "Purple Deep","slug": "purple-deep","color": "#241B43" },
                { "name": "Gold",      "slug": "gold",      "color": "#C9A04A" },
                { "name": "Gold Soft", "slug": "gold-soft", "color": "#E8C870" },
                { "name": "Gold Deep", "slug": "gold-deep", "color": "#A87B2A" },
                { "name": "Cream",     "slug": "cream",     "color": "#FAF8F2" },
                { "name": "Ink",       "slug": "ink",       "color": "#1A1A1A" },
                { "name": "Ink Soft",  "slug": "ink-soft",  "color": "#54545A" }
            ],
            "gradients": [
                {
                    "name": "Navy Fade",
                    "slug": "navy-fade",
                    "gradient": "linear-gradient(180deg, #1F2A52 0%, #0E1530 100%)"
                },
                {
                    "name": "Purple Fade",
                    "slug": "purple-fade",
                    "gradient": "linear-gradient(135deg, #3D2C6B 0%, #1F2A52 100%)"
                },
                {
                    "name": "Cream Fade",
                    "slug": "cream-fade",
                    "gradient": "linear-gradient(180deg, #FAF8F2 0%, #FFFFFF 100%)"
                },
                {
                    "name": "Gold Fade",
                    "slug": "gold-fade",
                    "gradient": "linear-gradient(135deg, #E8C870 0%, #A87B2A 100%)"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Fraunces', 'Cormorant Garamond', Georgia, serif",
                    "name": "Display",
                    "slug": "display"
                },
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "name": "Body",
                    "slug": "body"
                }
            ],
            "fontSizes": [
                { "name": "Small",   "slug": "small",   "size": "0.875rem", "fluid": false },
                { "name": "Body",    "slug": "body",    "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
                { "name": "Lede",    "slug": "lede",    "size": "1.25rem",  "fluid": { "min": "1.125rem", "max": "1.375rem" } },
                { "name": "H3",      "slug": "h-3",     "size": "1.5rem",   "fluid": { "min": "1.375rem", "max": "1.75rem" } },
                { "name": "H2",      "slug": "h-2",     "size": "2.5rem",   "fluid": { "min": "2rem", "max": "3rem" } },
                { "name": "H1",      "slug": "h-1",     "size": "3.75rem",  "fluid": { "min": "2.75rem", "max": "5rem" } },
                { "name": "Display", "slug": "display", "size": "5.5rem",   "fluid": { "min": "3.25rem", "max": "7rem" } }
            ]
        },
        "layout": {
            "contentSize": "760px",
            "wideSize": "1320px"
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 7,
                "mediumStep": 1.5,
                "unit": "rem"
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--paper)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--body)",
            "lineHeight": "1.65",
            "letterSpacing": "0"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-1)",
                    "fontWeight": "500",
                    "lineHeight": "1.04",
                    "letterSpacing": "-0.02em"
                },
                "color": { "text": "var(--wp--preset--color--navy)" }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-2)",
                    "fontWeight": "500",
                    "lineHeight": "1.12",
                    "letterSpacing": "-0.018em"
                },
                "color": { "text": "var(--wp--preset--color--navy)" }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-3)",
                    "fontWeight": "600",
                    "lineHeight": "1.25"
                },
                "color": { "text": "var(--wp--preset--color--navy)" }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--navy)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--gold-deep)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--navy)",
                    "text": "var(--wp--preset--color--paper)"
                },
                "border": {
                    "radius": "999px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.95rem",
                        "right": "2rem",
                        "bottom": "0.95rem",
                        "left": "2rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontWeight": "600",
                    "fontSize": "0.95rem",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "color": {
                    "text": "var(--wp--preset--color--navy)"
                }
            },
            "core/quote": {
                "border": {
                    "color": "var(--wp--preset--color--gold)",
                    "style": "solid",
                    "width": "0 0 0 4px"
                },
                "spacing": {
                    "padding": {
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontStyle": "italic",
                    "fontSize": "1.375rem",
                    "lineHeight": "1.4"
                }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "customTemplates": [
        { "name": "page-wide",   "title": "Page — Wide",   "postTypes": ["page"] },
        { "name": "page-narrow", "title": "Page — Narrow", "postTypes": ["page"] }
    ]
}

{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "name": "Navy",         "slug": "navy",      "color": "#0A2540" },
                { "name": "Navy Deep",    "slug": "navy-deep", "color": "#061A2E" },
                { "name": "Cream",        "slug": "cream",     "color": "#F8F6F3" },
                { "name": "Magenta",      "slug": "gold",      "color": "#D6206E" },
                { "name": "Magenta Soft", "slug": "gold-soft", "color": "#E85590" },
                { "name": "Red",          "slug": "red",       "color": "#C8102E" },
                { "name": "Sage",         "slug": "sage",      "color": "#6B7C5E" },
                { "name": "Paper",        "slug": "paper",     "color": "#FFFFFF" },
                { "name": "Ink",          "slug": "ink",       "color": "#1A1A1A" },
                { "name": "Ink Soft",     "slug": "ink-soft",  "color": "#4A4A4A" }
            ],
            "gradients": [
                {
                    "name": "Navy Fade",
                    "slug": "navy-fade",
                    "gradient": "linear-gradient(180deg, #0A2540 0%, #061A2E 100%)"
                },
                {
                    "name": "Cream Fade",
                    "slug": "cream-fade",
                    "gradient": "linear-gradient(180deg, #F8F6F3 0%, #FFFFFF 100%)"
                },
                {
                    "name": "Magenta Fade",
                    "slug": "magenta-fade",
                    "gradient": "linear-gradient(135deg, #D6206E 0%, #C8102E 100%)"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
                    "name": "Display",
                    "slug": "display"
                },
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "name": "Body",
                    "slug": "body"
                }
            ],
            "fontSizes": [
                { "name": "Small",   "slug": "small",   "size": "0.875rem", "fluid": false },
                { "name": "Body",    "slug": "body",    "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
                { "name": "Lede",    "slug": "lede",    "size": "1.25rem",  "fluid": { "min": "1.125rem", "max": "1.375rem" } },
                { "name": "H3",      "slug": "h-3",     "size": "1.5rem",   "fluid": { "min": "1.375rem", "max": "1.75rem" } },
                { "name": "H2",      "slug": "h-2",     "size": "2.25rem",  "fluid": { "min": "1.875rem", "max": "2.75rem" } },
                { "name": "H1",      "slug": "h-1",     "size": "3.5rem",   "fluid": { "min": "2.5rem", "max": "4.5rem" } },
                { "name": "Display", "slug": "display", "size": "5rem",     "fluid": { "min": "3rem", "max": "6.5rem" } }
            ]
        },
        "layout": {
            "contentSize": "720px",
            "wideSize": "1280px"
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 7,
                "mediumStep": 1.5,
                "unit": "rem"
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--paper)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--body)",
            "lineHeight": "1.65",
            "letterSpacing": "0"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-1)",
                    "fontWeight": "500",
                    "lineHeight": "1.05",
                    "letterSpacing": "-0.02em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-2)",
                    "fontWeight": "500",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.015em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--h-3)",
                    "fontWeight": "600",
                    "lineHeight": "1.25"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--navy)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--gold)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--gold)",
                    "text": "var(--wp--preset--color--paper)"
                },
                "border": {
                    "radius": "999px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.95rem",
                        "right": "2rem",
                        "bottom": "0.95rem",
                        "left": "2rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontWeight": "600",
                    "fontSize": "1rem",
                    "letterSpacing": "0.02em",
                    "textTransform": "uppercase"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "color": {
                    "text": "var(--wp--preset--color--navy)"
                }
            },
            "core/quote": {
                "border": {
                    "color": "var(--wp--preset--color--red)",
                    "style": "solid",
                    "width": "0 0 0 4px"
                },
                "spacing": {
                    "padding": {
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontStyle": "italic",
                    "fontSize": "1.375rem",
                    "lineHeight": "1.4"
                }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "customTemplates": [
        { "name": "page-wide",   "title": "Page — Wide",   "postTypes": ["page"] },
        { "name": "page-narrow", "title": "Page — Narrow", "postTypes": ["page"] }
    ]
}
